# Supabase (usar SERVICE_ROLE_KEY, no la anon key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# WAHA (dentro de Docker, usar nombre del container)
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=condi
WAHA_SESSION=default

# ID del negocio en la tabla negocios de Supabase
NEGOCIO_ID=

# IA — OpenAI (principal) + Anthropic (fallback)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Info del negocio (para el system prompt del bot)
NEGOCIO_NOMBRE=Cruz Barber Studio
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=

# Polling y puerto
POLL_INTERVAL_MS=2000
BOT_PORT=4000
