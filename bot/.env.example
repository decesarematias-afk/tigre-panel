# Supabase (usar SERVICE_ROLE_KEY, no la anon key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# WAHA (dentro de Docker, usar nombre del container)
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=condi
WAHA_SESSION=default

# ID del negocio en la tabla negocios de Supabase
NEGOCIO_ID=

# IA — OpenAI (principal) + Anthropic (fallback)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Info del negocio (para el system prompt del bot)
NEGOCIO_NOMBRE=Cruz Barber Studio
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=

# Chat ID del dueño (se ve en WAHA dashboard, ej: 237713622040718@lid)
# Forma más confiable de identificar al dueño, especialmente con formato @lid
OWNER_CHAT_ID=

# Clave de acceso para que el dueño se autentique por WhatsApp (opcional)
# El dueño envía esta clave al bot y queda autenticado
OWNER_ACCESS_KEY=

# Owners extra (desarrolladores/testers) que también tienen acceso de dueño
# Formato: phone:chatId separados por coma. Ej: 5491130657887:179710390718526@lid
EXTRA_OWNERS=

# Polling y puerto
POLL_INTERVAL_MS=2000
BOT_PORT=4000
